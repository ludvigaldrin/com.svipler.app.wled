{
  "id": "set_segment_brightness",
  "title": { "en": "Set brightness on a segment" },
  "titleFormatted": { "en": "Set brightness of [[segment]] to [[brightness]]" },
  "hint": { "en": "Sets the brightness of one segment only. This is separate from the overall brightness of the device." },
  "args": [
    { "name": "device", "type": "device", "filter": "driver_id=wled" },
